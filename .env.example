# ---- Local development (values printed by `supabase status`) ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # scripts only (seed, legal sync, bootstrap). NEVER ship to clients.
RUNLIME_ENV=local                     # local | staging | production (dev seed refuses production)
RUNLIME_PRODUCTION_SUPABASE_URL=      # safety net for scripts: refuses to seed this URL
SEED_DEV_PASSWORD=                    # optional; dev/staging seed accounts only

# ---- Web (apps/web/.env.local) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Mobile (apps/mobile/.env or EAS secrets) ----
APP_ENV=development
APP_BUNDLE_ID=tt.runlime.app.dev
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_WEB_URL=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# ---- Edge Function secrets (supabase/functions/.env locally; `supabase secrets set` for hosted) ----
EMERGENCY_CONTACT_KEY_VERSION=1
EMERGENCY_CONTACT_KEY_V1=             # 32 random bytes, base64: openssl rand -base64 32
ALLOWED_ORIGINS=http://localhost:3000
