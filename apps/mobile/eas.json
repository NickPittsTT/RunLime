{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "APP_ENV": "development" }, "channel": "development" },
    "staging": { "distribution": "internal", "env": { "APP_ENV": "staging" }, "channel": "staging" },
    "production": { "autoIncrement": true, "env": { "APP_ENV": "production" }, "channel": "production" }
  },
  "submit": { "production": {} }
}
