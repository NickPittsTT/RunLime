{
  "name": "runlime",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/shared/src/db.types.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "legal:sync": "tsx scripts/sync-legal.ts",
    "bootstrap:super-admin": "tsx scripts/bootstrap-super-admin.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@supabase/supabase-js": "2.117.3",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "glob@>=10.2.0 <10.5.0": "^10.5.0",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "undici@>=6.23.0 <6.29.1": "^6.29.1",
      "undici@>=7.18.0 <7.30.1": "^7.30.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
