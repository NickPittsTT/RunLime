-- Shared pgTAP helpers. Included with \ir inside each test transaction (rolled back afterwards).
create extension if not exists pgtap with schema extensions;
create schema if not exists tests;

create or replace function tests.create_user(p_email text, p_dob date default '1990-01-01', p_with_profile boolean default true)
returns uuid language plpgsql as $$
declare v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, instance_id, aud, role, email, raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
  values (v_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',
          split_part(p_email, '@', 1) || '.' || left(v_id::text, 8) || '@pgtap.test',
          '{"provider":"email"}', '{}', now(), now());
  -- (emails are made unique per run so tests never collide with seeded or real data)
  if p_with_profile then
    insert into public.profiles (id, display_name, date_of_birth, home_region_id)
    values (v_id, split_part(p_email, '@', 1), p_dob, (select id from public.regions where kind = 'area' order by sort limit 1));
    insert into public.user_roles (user_id, role) values (v_id, 'participant');
  end if;
  return v_id;
end $$;

create or replace function tests.authenticate_as(p_user uuid, p_aal text default 'aal1') returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('sub', p_user, 'role', 'authenticated', 'aal', p_aal)::text, true);
  perform set_config('request.jwt.claim.sub', p_user::text, true);
  perform set_config('role', 'authenticated', true);
end $$;

create or replace function tests.authenticate_anon() returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  perform set_config('request.jwt.claim.sub', '', true);
  perform set_config('role', 'anon', true);
end $$;

create or replace function tests.clear_authentication() returns void language plpgsql as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', null, true);
  perform set_config('request.jwt.claim.sub', null, true);
end $$;

create or replace function tests.area_id(p_name text default 'Central') returns uuid language sql as $$
  select id from public.regions where name = p_name and kind = 'area'
$$;

grant usage on schema tests to anon, authenticated;
grant execute on all functions in schema tests to anon, authenticated;
